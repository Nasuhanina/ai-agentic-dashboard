# Copy this file to `.env` (same folder) and edit as needed.
# `.env` is gitignored, so keys are never committed.

# --- Recommender provider ---------------------------------------------------
# auto | opencode | deepseek | off   (default: auto)
# auto uses the opencode server when configured, otherwise DeepSeek if a key exists.
RECOMMENDER_PROVIDER=opencode

# --- opencode provider (uses your opencode models, no API key needed) -------
# Run `opencode serve` (default port 4096), then set:
OPENCODE_SERVER_URL=http://127.0.0.1:4096
OPENCODE_MODEL=opencode-go/deepseek-v4.1-flash
# OPENCODE_SERVER_USERNAME=opencode
# OPENCODE_SERVER_PASSWORD=your-password

# --- DeepSeek direct API (alternative to opencode) --------------------------
# DEEPSEEK_API_KEY=sk-your-deepseek-key-here
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com
